<!DOCTYPE html>
<html lang="da">

<head>
    <meta charset="UTF-8">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/stil.css">
</head>

<body>
    <!-- Detaljesiden samler alle budgettrin for én investeringscase. -->
    <header>
        <h1>
            <%= title %>
        </h1>
        <nav>
            <a href="/investment-cases">← Tilbage til cases</a>
        </nav>
    </header>
    <main>

        <!-- Trinbar: viser brugerens placering i 5-trins-flowet og giver hurtig adgang til hvert trin. -->
        <nav class="step-bar" aria-label="Trin i investeringscase">
            <button type="button" class="step-bar-item" data-target="1">1. Køb</button>
            <button type="button" class="step-bar-item" data-target="2">2. Finansiering</button>
            <button type="button" class="step-bar-item" data-target="3">3. Renovering</button>
            <button type="button" class="step-bar-item" data-target="4">4. Drift</button>
            <button type="button" class="step-bar-item" data-target="5">5. Udlejning</button>
        </nav>

        <!-- Trin 1: Køb og omkostninger -->
        <section class="page-card" data-step="1">
            <h2>Trin 1: Køb og omkostninger</h2>
            <!-- Købsomkostninger bruges til startkapitalen i simulationen. -->
            <form id="koeb-form">
                <div class="field-group">
                    <label for="koeb-beskrivelse">Beskrivelse</label>
                    <input id="koeb-beskrivelse" type="text" placeholder="fx Ejendomspris">
                </div>
                <div class="field-group">
                    <label for="koeb-beloeb">Beløb (kr)</label>
                    <!-- Beløbsfelter bruger text + data-format-number, så JS kan vise tusindtalsprikker. -->
                    <input id="koeb-beloeb" type="text" inputmode="numeric" data-format-number placeholder="fx 2.500.000">
                </div>
                <button type="submit">Tilføj</button>
                <p id="koeb-status"></p>
            </form>
            <ul id="koeb-liste"></ul>
            <p id="koeb-total" class="trin-total">Total: 0 kr</p>
            <div class="step-nav">
                <button type="button" class="step-back" data-target="0" disabled>Tilbage</button>
                <button type="button" class="step-next" data-target="2">Næste</button>
            </div>
        </section>

        <!-- Trin 2: Finansiering -->
        <section class="page-card" data-step="2">
            <h2>Trin 2: Finansiering</h2>
            <!-- Der gemmes én finansiering pr. case. -->
            <form id="finansiering-form">
                <div class="field-group">
                    <label for="laanebeloeb">Lånebeløb (kr)</label>
                    <input id="laanebeloeb" type="text" inputmode="numeric" data-format-number placeholder="fx 2.000.000">
                </div>
                <div class="field-group">
                    <label for="rente">Rente (%)</label>
                    <input id="rente" type="number" step="0.1" placeholder="fx 4">
                </div>
                <div class="field-group">
                    <label for="løbetid">Løbetid (år)</label>
                    <input id="løbetid" type="number" placeholder="fx 30">
                </div>
                <div class="field-group">
                    <label for="afdragsfri">Afdragsfri periode (år)</label>
                    <input id="afdragsfri" type="number" placeholder="fx 0">
                </div>
                <div class="field-group">
                    <label for="laanetype">Lånetype</label>
                    <input id="laanetype" type="text" placeholder="fx fastforrentet">
                </div>
                <button type="submit">Gem finansiering</button>
                <p id="finansiering-status"></p>
            </form>
            <div class="step-nav">
                <button type="button" class="step-back" data-target="1">Tilbage</button>
                <button type="button" class="step-next" data-target="3">Næste</button>
            </div>
        </section>

        <!-- Trin 3: Renovering -->
        <section class="page-card" data-step="3">
            <h2>Trin 3: Renovering</h2>
            <!-- Renoveringer har et år, så de kan påvirke simulationen på rette tidspunkt. -->
            <form id="renovering-form">
                <div class="field-group">
                    <label for="ren-beskrivelse">Beskrivelse</label>
                    <input id="ren-beskrivelse" type="text" placeholder="fx Køkken renovering">
                </div>
                <div class="field-group">
                    <label for="ren-beloeb">Beløb (kr)</label>
                    <input id="ren-beloeb" type="text" inputmode="numeric" data-format-number placeholder="fx 150.000">
                </div>
                <div class="field-group">
                    <label for="ren-år">År (hvornår)</label>
                    <input id="ren-år" type="number" placeholder="fx 5">
                </div>
                <button type="submit">Tilføj</button>
                <p id="renovering-status"></p>
            </form>
            <ul id="renovering-liste"></ul>
            <div class="step-nav">
                <button type="button" class="step-back" data-target="2">Tilbage</button>
                <button type="button" class="step-next" data-target="4">Næste</button>
            </div>
        </section>

        <!-- Trin 4: Driftsbudget -->
        <section class="page-card" data-step="4">
            <h2>Trin 4: Driftsbudget</h2>
            <!-- Driftsudgifter gemmes månedligt og summeres i frontend. -->
            <form id="drift-form">
                <div class="field-group">
                    <label for="drift-navn">Navn</label>
                    <input id="drift-navn" type="text" placeholder="fx Forsikring">
                </div>
                <div class="field-group">
                    <label for="drift-beloeb">Beløb pr. måned (kr)</label>
                    <input id="drift-beloeb" type="text" inputmode="numeric" data-format-number placeholder="fx 500">
                </div>
                <button type="submit">Tilføj</button>
                <p id="drift-status"></p>
            </form>
            <ul id="drift-liste"></ul>
            <p id="drift-total" class="trin-total">Total: 0 kr/md (0 kr/år)</p>
            <div class="step-nav">
                <button type="button" class="step-back" data-target="3">Tilbage</button>
                <button type="button" class="step-next" data-target="5">Næste</button>
            </div>
        </section>

        <!-- Trin 5: Udlejning -->
        <section class="page-card" data-step="5">
            <h2>Trin 5: Udlejning</h2>
            <!-- Udlejningstal bruges til nettoleje og cashflow. -->
            <form id="udlejning-form">
                <div class="field-group">
                    <label for="månedlig-leje">Månedlig leje (kr)</label>
                    <input id="månedlig-leje" type="text" inputmode="numeric" data-format-number placeholder="fx 8.000">
                </div>
                <div class="field-group">
                    <label for="månedlig-udgift">Månedlige udgifter (kr)</label>
                    <input id="månedlig-udgift" type="text" inputmode="numeric" data-format-number placeholder="fx 500">
                </div>
                <button type="submit">Gem udlejning</button>
                <p id="udlejning-status"></p>
            </form>
            <p id="udlejning-total" class="trin-total">Netto-leje: 0 kr/md (0 kr/år)</p>
            <div class="step-nav">
                <button type="button" class="step-back" data-target="4">Tilbage</button>
                <button type="button" class="step-next" data-target="6">Videre til simulation</button>
            </div>
        </section>

        <!-- Simulering: 30-års udvikling baseret på casens parametre.
             Trin 6 i flowet (uden for trinbar — nås kun via "Videre til simulation"-knappen). -->
        <section class="page-card" data-step="6">
            <h2>Simulering — 30 års udvikling</h2>
            <p class="help-text">
                Tager værdier fra trin 1-5 og simulerer egenkapital, cashflow og
                restgæld år for år. Klik på knappen for at hente de seneste data
                og tegne grafen.
            </p>
            <button id="sim-button" type="button">Kør simulation</button>
            <p id="sim-status" class="help-text">Klar til at simulere.</p>
            <div class="chart-panel">
                <canvas id="sim-chart"></canvas>
            </div>
            <div class="step-nav">
                <button type="button" class="step-back" data-target="5">Tilbage til udlejning</button>
            </div>
        </section>

    </main>
    <script>
        // Gør caseId tilgængeligt for JavaScript
        const CASE_ID = <%= caseId %>;
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/investeringscaseDetalje.js"></script>
</body>

</html>
